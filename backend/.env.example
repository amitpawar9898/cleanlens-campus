PORT=4000
NODE_ENV=development
DATABASE_URL=postgres://postgres:postgres@localhost:5432/cleanlens
JWT_SECRET=change-this-to-a-long-random-string
ACCESS_TTL=15m
REFRESH_DAYS=30
CORS_ORIGIN=*
UPLOAD_DIR=uploads
PUBLIC_REGISTRATION=true
# AI (server-side only; choose auto or a named provider)
AI_PROVIDER=auto
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
ENABLE_GEMINI_FALLBACK=true
GEMINI_VERIFY_ALL=false
GEMINI_TIMEOUT_MS=25000
GEMINI_MIN_LOCAL_OBJECTS=2
YOLO_CONFIDENCE=0.20
# Backward-compatible alias; prefer GEMINI_API_KEY
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=
# Password reset email (Resend API, credentials remain server-side)
FRONTEND_URL=http://localhost:4000
EMAIL_PROVIDER=console
EMAIL_API_KEY=
EMAIL_FROM=SIT CleanLens <onboarding@resend.dev>
# SMS OTP: console | twilio | fast2sms
SMS_PROVIDER=console
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=
FAST2SMS_KEY=
# Required: create the first administrator with your own credentials before `npm run seed`
SEED_ADMIN_EMAIL=admin@your-campus.edu
SEED_ADMIN_PASSWORD=replace-with-a-unique-password-at-least-12-characters
